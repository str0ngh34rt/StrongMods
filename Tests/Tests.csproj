<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The repo's test project (#14) — tooling, not a mod. It deliberately imports none of the build\ entry points:
    nothing stages, nothing deploys, XML lint does not apply. It runs on modern .NET (the spike on #14 proved the
    game's assemblies load and resolve headlessly there), so none of the net481 mod defaults apply either.

    The unit under test is whatever $(SdtdDir) resolves to — live install, vendored tree, or CI package tree —
    with the exact same precedence and layout detection the build uses (build\GamePaths.props). The resolved
    paths are baked into the assembly as metadata below; switching units is a rebuild with -p:SdtdDir=...
  -->
  <Import Project="..\build\GamePaths.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ModDeploy>false</ModDeploy>
    <!-- A repo-root-relative -p:SdtdDir=vendor/... (the documented usage) trips GamePaths.props twice: its
         layout detection Exists() and this project's HintPath both resolve relative paths against the PROJECT
         directory, not the invocation directory the caller meant. Anchor to the invocation directory and re-run
         the layout detection (same two-condition logic as build\GamePaths.props) on the anchored path; absolute
         inputs pass through all of this unchanged. -->
    <SdtdDirAbs>$([System.IO.Path]::GetFullPath('$(SdtdDir)'))</SdtdDirAbs>
    <SdtdManagedDir Condition="Exists('$(SdtdDirAbs)\7DaysToDieServer_Data\Managed')">$(SdtdDirAbs)\7DaysToDieServer_Data\Managed</SdtdManagedDir>
    <SdtdManagedDir Condition="!Exists('$(SdtdDirAbs)\7DaysToDieServer_Data\Managed')">$(SdtdDirAbs)\7DaysToDie_Data\Managed</SdtdManagedDir>
    <SdtdHarmonyDir>$([System.IO.Path]::GetFullPath('$(SdtdHarmonyDir)'))</SdtdHarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The MonoMod builds shipped beside the game's thin 0Harmony are net4x and DO NOT EXECUTE on modern .NET
         (MonoMod.Utils.ReflectionHelper's initializer trips MethodAccessException on a SignatureHelper overload
         CoreCLR no longer exposes — found when #48 step 3 tried resolving them from the game folder). These
         packages supply the modern-TFM builds of the same versions the game's 0Harmony references. -->
    <PackageReference Include="MonoMod.Backports" Version="1.1.2" />
    <PackageReference Include="MonoMod.Utils" Version="25.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against the game's own Harmony, so [HarmonyPatch] attribute instances read from mod assemblies
         share type identity with the HarmonyLib types used here. Private=false: nothing is copied from the game
         folder — copying would also drag in its net4x MonoMod/Cecil siblings (present since #48's wholesale
         vendoring), colliding with the modern-TFM package copies above. 0Harmony itself resolves at runtime from
         $(SdtdHarmonyDir) via GameTree's static-ctor hook on the default load context. -->
    <Reference Include="0Harmony">
      <HintPath>$(SdtdHarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SdtdManagedDir" Value="$(SdtdManagedDir)" />
    <AssemblyMetadata Include="SdtdHarmonyDir" Value="$(SdtdHarmonyDir)" />
    <AssemblyMetadata Include="RepoRoot" Value="$(MSBuildProjectDirectory)\..\" />
    <AssemblyMetadata Include="Configuration" Value="$(Configuration)" />
  </ItemGroup>

  <!-- Solution-scope `-t:Deploy` invokes Deploy on every project; every other project gets one from its build\
       entry point. This project installs nothing, so its Deploy is explicitly a no-op. -->
  <Target Name="Deploy" />

</Project>
