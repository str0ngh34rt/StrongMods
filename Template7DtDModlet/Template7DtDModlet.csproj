<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<!--#if (IsTemplate) -->
  <PropertyGroup>
    <!-- The template project itself is scaffolding, not a shippable modlet, so it must never install into the game.
         `dotnet new` strips this block when generating a project, so generated modlets deploy normally. -->
    <ModDeploy>false</ModDeploy>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
<!--#endif -->
  <Import Project="..\build\Modlet.targets" />
</Project>
