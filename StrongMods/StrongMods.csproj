<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Mod.props" />
  <PropertyGroup>
    <!-- The building block other mods build on: replaces the XML patcher and validates dependencies, so it must
         precede everything it serves (including Gears). Only the game-enforced Harmony mods load earlier. -->
    <ModLoadTier>First</ModLoadTier>
  </PropertyGroup>
  <ItemGroup>
    <GameAssembly Include="Noemax.GZip" />
  </ItemGroup>
  <Import Project="..\build\Mod.targets" />
</Project>
