<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Mod.props" />
  <PropertyGroup>
    <!-- Loads late so its XML patches apply after the mods they depend on. -->
    <ModLoadPrefix>ZZZZZZZZZZ_</ModLoadPrefix>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=false: StrongMods deploys itself; its DLL must not be duplicated into this mod's folder. -->
    <ProjectReference Include="..\StrongMods\StrongMods.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>
  <Import Project="..\build\Mod.targets" />
</Project>
