<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Loads late so its tweaks apply after the mods they adjust. -->
    <ModLoadPrefix>ZZZZZZZZZZ_</ModLoadPrefix>
    <!-- Saves\ does not belong in the mod folder; it installs into the player's saves directory instead. -->
    <ModletContentExclude>Saves\**\*</ModletContentExclude>
    <SavesOutputPath Condition="'$(SavesOutputPath)' == ''">$(AppData)\7DaysToDie\Saves</SavesOutputPath>
  </PropertyGroup>
  <Import Project="..\build\Modlet.targets" />
  <ItemGroup>
    <SavesContent Include="Saves\**\*" />
  </ItemGroup>
  <!-- The one modlet that installs somewhere other than Mods\, so it keeps its own copy step rather than
       complicating Modlet.targets for a single case. Redirect with -p:SavesOutputPath=... to test safely. -->
  <Target Name="CopySaves" AfterTargets="Build">
    <Copy SourceFiles="@(SavesContent)"
          DestinationFiles="@(SavesContent->'$(SavesOutputPath)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
