<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Project="..\build\Mod.props" />
  <PropertyGroup>
    <ProjectGuid>{031D66E3-00A6-4AAD-85B9-7F26BFC9EFAF}</ProjectGuid>
    <!-- PackageReference rather than packages.config, so any standard toolchain can restore: `msbuild -restore`,
         `dotnet restore`, or an IDE on load. packages.config would need a hand-downloaded nuget.exe, which ships
         with neither MSBuild nor the .NET SDK. A non-SDK project has to opt in explicitly; this is set here rather
         than in build\Mod.props so that no other project in the repo becomes restore-aware. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <!-- The one real NuGet dependency in the repo. Left copy-local, so Cronos.dll ships alongside the mod. -->
    <PackageReference Include="Cronos" Version="0.11.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BloodRain.cs" />
    <Compile Include="BloodRainChatCommand.cs" />
    <Compile Include="BloodRainConsoleCommand.cs" />
    <Compile Include="BloodRainChallenge.cs" />
    <Compile Include="BloodRainParty.cs" />
    <Compile Include="HarmonyPatches.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="..\build\Mod.targets" />
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
