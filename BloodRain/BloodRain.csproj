<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Mod.props" />
  <PropertyGroup>
    <!-- Keeps Cronos.xml deploying beside Cronos.dll, as it always has. The SDK does not copy package
         documentation files by default; this property only exists on the SDK asset path. -->
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
  </PropertyGroup>
  <ItemGroup>
    <!-- The one real NuGet dependency in the repo, restored from nuget.org on first build. SDK-style projects
         consume package assets natively under every toolchain, which is what let F1 collapse the legacy
         GeneratePathProperty workaround (see git history of this file). -->
    <PackageReference Include="Cronos" Version="0.11.0" />
  </ItemGroup>
  <Import Project="..\build\Mod.targets" />
</Project>
