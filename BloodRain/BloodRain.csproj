<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Project="..\build\Mod.props" />
  <PropertyGroup>
    <ProjectGuid>{031D66E3-00A6-4AAD-85B9-7F26BFC9EFAF}</ProjectGuid>
    <!-- PackageReference rather than packages.config, so any standard toolchain can restore: `msbuild -restore`,
         `dotnet restore`, or an IDE on load. packages.config would need a hand-downloaded nuget.exe, which ships
         with neither MSBuild nor the .NET SDK. A non-SDK project has to opt in explicitly; this is set here rather
         than in build\Mod.props so that no other project in the repo becomes restore-aware. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <!-- The one real NuGet dependency in the repo. $(PkgCronos) is generated by restore (GeneratePathProperty) and
         points at the restored package, so nothing here hardcodes a version or a ..\packages\ location.
         The explicit <Reference> is deliberate. A legacy (non-SDK) project turns restored assets into references
         via ResolveNuGetPackageAssets, which ships with full MSBuild but NOT with the .NET SDK. So a bare
         PackageReference builds under msbuild.exe yet fails with CS0246 under `dotnet build`, which restores the
         package and then ignores it. Routing through a HintPath works under both, and keeps Cronos.xml deploying
         via copy-local as it always has. F1 (SDK-style) can collapse this back to a bare PackageReference. -->
    <PackageReference Include="Cronos" Version="0.11.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="Cronos">
      <HintPath>$(PkgCronos)\lib\net45\Cronos.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BloodRain.cs" />
    <Compile Include="BloodRainChatCommand.cs" />
    <Compile Include="BloodRainConsoleCommand.cs" />
    <Compile Include="BloodRainChallenge.cs" />
    <Compile Include="BloodRainParty.cs" />
    <Compile Include="HarmonyPatches.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="..\build\Mod.targets" />
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
