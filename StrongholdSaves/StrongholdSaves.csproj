<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\build\Overlay.props" />
  <PropertyGroup>
    <!-- Stronghold-specific save/world config, overlaid into the game-managed Saves\ tree. Split out of
         StrongholdTweaks (issue #25): save-related config is not a Mod and never belonged in Mods\. The Saves\
         tree is runtime territory, so only the file below is mirrored; nothing else is ever touched. -->
    <DeployRoot>$(SdtdSavesDir)</DeployRoot>
    <!-- The project README documents the repo project; it does not belong in the game's Saves\ tree. -->
    <OverlayContentExclude>README.md</OverlayContentExclude>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <MirrorOnDeploy Include="StrongMods\custom_chat_commands.xml" />
  </ItemGroup>
  <Import Project="..\build\Overlay.targets" />
</Project>
