<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- No Clean target: the deployed folder accumulates un-version-controlled world files (Worlds\), and
         removing the directory would destroy them. -->
    <ModletCleanEnabled>false</ModletCleanEnabled>
  </PropertyGroup>
  <Import Project="..\build\Modlet.targets" />
</Project>
