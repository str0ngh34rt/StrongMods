<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>97bbe6ec-c211-45d6-ad69-e31286b879e0</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>ClaudeConfig</Import_RootNamespace>
  </PropertyGroup>
  <!-- Everything in .claude/ becomes visible to the IDE (and its inspections) via this glob, per machine,
       including gitignored files where they exist. Backups are excluded as churn nobody edits. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)**\*" Exclude="$(MSBuildThisFileDirectory)*.shproj;$(MSBuildThisFileDirectory)*.projitems;$(MSBuildThisFileDirectory)memory-backup-*\**" />
  </ItemGroup>
</Project>
