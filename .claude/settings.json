{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git --version)",
      "Bash(git version)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git check-ignore *)",
      "Bash(git worktree add .scratch*)",
      "Bash(git worktree add -d .scratch*)",
      "Bash(git worktree add --detach .scratch*)",
      "Bash(git worktree remove .scratch*)",
      "Bash(git worktree remove -f .scratch*)",
      "Bash(git worktree remove --force .scratch*)",
      "Bash(git worktree prune)",

      "Bash(gh --version)",
      "Bash(gh version)",
      "Bash(gh auth status *)",
      "Bash(gh label list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue reopen *)"
    ],
    "ask": [
      "Bash(git branch *)",
      "Bash(git worktree add * -b *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git stash *)",
      "Bash(git worktree *..*)",
      "Bash(git worktree add * -B *)",

      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)"
    ]
  }
}
