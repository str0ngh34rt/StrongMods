<Project>

  <!--
    Shared build logic for XML-only modlets: there is nothing to compile, so Build stages the content into bin\
    and Clean removes the staging folder. Installing is the explicit Deploy target (build\Deploy.targets,
    imported below): dotnet build -t:Deploy. Building never touches a live install.

    A modlet project imports this explicitly (modlets have no Microsoft.Common.props import, so MSBuild's
    Directory.Build.props auto-import does not reach them). Extension points a project may set before the import:
      <ModLoadTier>AfterDependencies</ModLoadTier>  deploy-folder load order (tiers: build\Deploy.targets)
      <ModsDir>...</ModsDir>                        deploy somewhere other than the client install
      <ModletContentExclude>Saves\**\*</ModletContentExclude>   extra Exclude globs
  -->

  <Import Project="$(MSBuildThisFileDirectory)GamePaths.props" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath>bin\$(Configuration)</OutputPath>
    <ModStagingDir>$(OutputPath)\</ModStagingDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- bin/obj are excluded so a Release build does not re-copy its own output on the next run, and so build
         leftovers are never deployed into the game. .ai holds agent planning docs, which are not shipped. -->
    <Content Include="**\*"
             Exclude="*.csproj;bin\**\*;obj\**\*;.ai\**\*;.template.config\**\*;$(ModletContentExclude)" />
  </ItemGroup>

  <Target Name="Build">
    <!-- Staging is wholly ours, so a plain skip-unchanged copy suffices; the protective copy semantics that
         used to live here are the Overlay project type's concern now (issue #25). -->
    <Copy SourceFiles="@(Content)"
          DestinationFiles="@(Content->'$(OutputPath)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Clean touches only the staging folder — never a live install. (ModletCleanEnabled is gone: it existed to
       keep Clean away from deployed un-versioned files, a hazard that no longer exists.) -->
  <Target Name="Clean">
    <RemoveDir Directories="$(OutputPath)" Condition="Exists('$(OutputPath)')" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

  <!-- Answers NuGet's solution-restore probe. Modlets have no packages, so restore is a genuine no-op — but a
       project that lacks this target gets skipped with a scary NU1503 warning on every solution restore.
       Declaring ourselves restore-valid (the Returns item is how NuGet counts a "yes") makes the no-op silent.
       The underscore marks a NuGet-internal contract: if a NuGet update changes it, the failure mode is just the
       warnings returning. Verified empty-target-without-Returns does NOT suppress the warning. -->
  <Target Name="_IsProjectRestoreSupported" Returns="@(_ValidProjectsForRestore)">
    <ItemGroup>
      <_ValidProjectsForRestore Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
  </Target>

  <!-- `dotnet test` on the solution forwards VSTest to every project. SDK projects inherit the target from
       Microsoft.TestPlatform.ImportAfter.targets (auto-imported by Microsoft.Common.targets) and no-op it for
       anything without IsTestProject=true; a bare <Project> never sees that import, so without this the whole
       command fails with MSB4057 (issue #51). Same shape as the restore probe above, and as the no-op Deploy in
       Tests.csproj: a project that cannot participate in a solution-wide target says so with an empty target
       rather than an error. -->
  <Target Name="VSTest" />

  <Import Project="$(MSBuildThisFileDirectory)Deploy.targets" />
  <Import Project="$(MSBuildThisFileDirectory)XmlLint.targets" />

</Project>
