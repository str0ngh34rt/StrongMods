<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config for the CI restore of GameAssemblies.csproj ONLY (used via -\-configfile; also auto-discovered
  for restores of projects inside build/ci/, which is exactly this one). Mod projects live elsewhere and never
  see this file.

  Source mapping: 7DtD.* resolves ONLY from the private GitHub feed, everything else (Cronos for BloodRain)
  ONLY from nuget.org — hygiene against dependency confusion, and documentation of where bits come from.
  Credentials come from the environment (PACKAGES_READ_TOKEN, the bot's read-only token, set by CI from the
  repo secret); no token material ever lives in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/Strongheart-Games/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="7DtD.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="str0ngh34rt-bot" />
      <add key="ClearTextPassword" value="%PACKAGES_READ_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </github>
  </packageSourceCredentials>
</configuration>
