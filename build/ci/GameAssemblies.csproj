<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CI-only restore vehicle for the private game-assembly packages — never built, never in StrongMods.sln.
    The two Version attributes below are THE single place the consumed game version lives (plan §4): bumping a
    unit's package after a publish is a one-line change here (release.cs step 7 writes it), and the Build & Test
    run on main after the bump commit is the round-trip proof. The units version independently (a server-only
    hotfix bumps only the server package).

    Restored by .github/workflows/build-and-test.yml:
      dotnet restore build/ci/GameAssemblies.csproj -\-packages <isolated dir> -\-configfile build/ci/nuget.config

    Local restores of this project are neither needed nor expected: the sibling nuget.config points at the
    private GitHub feed and authenticates from the PACKAGES_READ_TOKEN environment variable, which only CI sets.
    Local verification uses vendored trees directly (-p:SdtdDir=vendor/...; CLAUDE.md "Building without the game").
  -->

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="7DtD.Assemblies.Game" Version="3.1.0.14" />
    <PackageReference Include="7DtD.Assemblies.DedicatedServer" Version="3.1.0.14" />
  </ItemGroup>

</Project>
