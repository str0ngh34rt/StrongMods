<Project>

  <!--
    Shared build logic for code-mod projects. A project imports this explicitly as the LAST element of its body:

      <Project Sdk="Microsoft.NET.Sdk">
        <Import Project="..\build\Mod.props" />
        ...project body...
        <Import Project="..\build\Mod.targets" />
      </Project>

    That position matters and is not negotiable. Sdk.targets (imported implicitly after the body) pulls in
    Microsoft.Common.CurrentVersion.targets, which derives OutDir, TargetDir and TargetPath from $(OutputPath)
    *during evaluation*, at the point it is imported. Setting OutputPath any later — e.g. from a
    Directory.Build.targets, which is imported at the very end — leaves OutDir latched to the bin\$(Configuration)\
    fallback, so the assembly is written to the wrong place while $(OutputPath) reads back correct. Querying
    $(OutputPath) alone does not reveal this; verify $(OutDir) and $(TargetDir).

    This is why the repo has no Directory.Build.props/.targets at all: their import positions are fixed by MSBuild
    and one of them is wrong for this. Every import here is explicit and positioned deliberately, and both project
    shapes (code mods, modlets) use the same mechanism.

    A project may set $(ModLoadPrefix), override $(ModsDir), or add <GameAssembly Include="..." /> items above the
    import.
  -->

  <PropertyGroup>
    <LangVersion>9</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);.ai\**</DefaultItemExcludes>

    <!-- Deploy folder name under Mods\. $(ModLoadPrefix) forces load order (e.g. 000000-, ZZ_). -->
    <ModDeployName Condition="'$(ModDeployName)' == ''">$(ModLoadPrefix)$(MSBuildProjectName)</ModDeployName>

    <!-- Per-project capability gate for the Deploy target below: <ModDeploy>false</ModDeploy> marks a project
         that must never install into the game — the dotnet new templates do this. (Renaming this property is
         tracked as issue #24.) -->
    <ModDeploy Condition="'$(ModDeploy)' == ''">true</ModDeploy>

    <!-- Building never touches a live install: output always stages to bin\, which holds exactly the shippable
         mod folder. Installing is the explicit Deploy target below (issue #13): dotnet build -t:Deploy -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assemblies resolved from the game's Managed folder. Add project-specific ones with
         <GameAssembly Include="Noemax.GZip" /> in the project body, above the import. -->
    <GameAssembly Include="mscorlib" />
    <GameAssembly Include="System" />
    <GameAssembly Include="System.Core" />
    <!-- Game assemblies type-forward through netstandard (Unity ships its own 2.1 shim). The pre-SDK build
         satisfied this invisibly via targeting-pack facade expansion; with implicit framework references disabled
         the game's own copy is referenced explicitly, like everything else. -->
    <GameAssembly Include="netstandard" />
    <GameAssembly Include="System.Xml" />
    <GameAssembly Include="System.Xml.Linq" />
    <GameAssembly Include="Assembly-CSharp" />
    <GameAssembly Include="LogLibrary" />
    <GameAssembly Include="UnityEngine" />
    <GameAssembly Include="UnityEngine.CoreModule" />
    <GameAssembly Include="UnityEngine.AudioModule" />

    <Reference Include="@(GameAssembly)">
      <HintPath>$(SdtdManagedDir)\%(Identity).dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(SdtdHarmonyDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModInfo.xml" Condition="Exists('$(MSBuildProjectDirectory)\ModInfo.xml')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md" Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Not restricted to *.xml: Config folders also hold Localization.csv. Verified against every project that
         each file already on disk under Config\ and Docs\ is one the project already shipped. -->
    <Content Include="Config\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Docs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The explicit install step: builds (if needed), then copies the staged mod folder into the live install.
       dotnet build <proj> -t:Deploy, or -t:Deploy on the solution (MSBuild forwards it to every project).
       SkipUnchangedFiles keeps re-deploys cheap. Deploying while $(SdtdDir) points at a vendored tree would
       "install" into the tree — don't combine -t:Deploy with -p:SdtdDir. -->
  <Target Name="Deploy" DependsOnTargets="Build" Condition="'$(ModDeploy)' == 'true'">
    <ItemGroup>
      <_DeployFile Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFile)"
          DestinationFiles="@(_DeployFile->'$(ModsDir)\$(ModDeployName)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="  $(MSBuildProjectName) deployed -> $(ModsDir)\$(ModDeployName)\" />
  </Target>

  <!-- Turn a missing/moved game install, or a forgotten Mod.props import, into one readable error instead of
       ~200 CS0246s or a silently wrong output folder. -->
  <Target Name="VerifyGameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(ModsDir)' == ''"
           Text="build\Mod.props was not imported by $(MSBuildProjectFile). Add &lt;Import Project=&quot;..\build\Mod.props&quot; /&gt; immediately after the Microsoft.Common.props import." />
    <Error Condition="!Exists('$(SdtdManagedDir)\Assembly-CSharp.dll')"
           Text="7 Days To Die was not found at '$(SdtdDir)'. Set SdtdDir in Local.props (copy Local.props.sample), set the SDTD_HOME environment variable, or pass -p:SdtdDir=..." />
  </Target>

</Project>
