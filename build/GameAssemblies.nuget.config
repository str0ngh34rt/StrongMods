<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config for restoring GameAssemblies.csproj ONLY, local or CI, always via -\-configfile. The filename
  is deliberately NOT nuget.config: an auto-discoverable name here would sit in the ancestor chain of every
  build\tools\*.cs run and change what those restores see. Mod projects restore through the repo-root
  NuGet.config and never touch the feed.

  Source mapping: 7DtD.* resolves ONLY from the private GitHub feed, everything else (Cronos for BloodRain)
  ONLY from nuget.org — hygiene against dependency confusion, and documentation of where bits come from.
  Credentials come from the environment (PACKAGES_READ_TOKEN — CI sets the bot's read token from the repo
  secret; a developer sets a personal read PAT); no token material ever lives in this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/Strongheart-Games/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="7DtD.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="str0ngh34rt-bot" />
      <add key="ClearTextPassword" value="%PACKAGES_READ_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </github>
  </packageSourceCredentials>
</configuration>
