<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The restore vehicle for the private game-assembly packages — never built, never in StrongMods.sln. Since
    the declared-version flip (#23) it serves local development AND CI: builds resolve each mod's declared
    version under packages\, and this project is what puts the trees there.

      dotnet restore build/GameAssemblies.csproj -\-packages packages -\-configfile build/GameAssemblies.nuget.config

    (from the repo root; PACKAGES_READ_TOKEN must hold a read PAT — classic, fine-grained ones don't cover the
    NuGet registry. CI restores to an isolated folder instead of packages\; a publisher verifying pre-push can
    restore from the local nupkgs: -s vendor/packages.)

    The Version attributes below pin what a DEFAULT build consumes; release.cs step 7 writes them after a
    publish, and the Build & Test run on main after the bump commit is the round-trip proof. The units version
    independently (a server-only hotfix bumps only the server package). Additional declared versions (per-mod
    pins, test versions) join the restore set in #23 phase 4 — the PackageDownload exact-version-list spike.
  -->

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="7DtD.Assemblies.Game" Version="3.1.0.14" />
    <PackageReference Include="7DtD.Assemblies.DedicatedServer" Version="3.1.0.14" />
  </ItemGroup>

</Project>
