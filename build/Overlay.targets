<Project>

  <!--
    Shared build logic for Overlay projects: content that deploys into a directory this repo does NOT fully
    manage — a third party's, the game's (Saves\), or content authored out-of-band (Hades' World Editor output).
    Third entry point beside Mod.targets and Modlet.targets; self-contained — never combine with the other entry
    points or Deploy.targets (their mirror Deploy target would collide with the overlay one below).

    Overlay deploy semantics (issue #25; settled in #13's review):
      - DEFAULT is protective-additive: copy a file if it is absent or newer at the destination, never overwrite
        newer live edits, never delete anything. Defaults fail toward the harmless side.
      - <MirrorOnDeploy> declares the directories/files the project definitively manages: within those scopes
        source is authoritative — overwrite and delete stale. Named for the consequence (robocopy /MIR): a
        declaration marks exactly where deletion may happen.
      - A Mod is an overlay that mirrors everything; these entry points differ only in that implicit declaration.

    MirrorOnDeploy takes literal directory or file identities, NOT wildcards — item globs would expand against
    the source tree at evaluation and lose the pattern needed for stale detection at the deploy root:

      <MirrorOnDeploy Include="Config" />                         directory: mirrored recursively
      <MirrorOnDeploy Include="ModInfo.xml" />                    single file
      <MirrorOnDeploy Include="Worlds\Hades S6\WalkerSim.xml" />  a managed file inside unmanaged territory

    Every overlay must set <DeployRoot> (e.g. $(ModsDir)\Hades, $(SdtdSavesDir)) — overlays state their
    destination explicitly; there is no Mods\<name> convention here. Because DeployRoot references shared
    properties, an overlay imports Overlay.props BEFORE its body (see its header for the incident that made this
    load-bearing) and this file after.

    Extension points, set between the two imports: <DeployRoot>, <MirrorOnDeploy> items,
    <OverlayContentExclude> extra staging excludes, <IsDeployable>false</IsDeployable> to never deploy.
  -->

  <PropertyGroup>
    <OutputPath>bin\$(Configuration)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**\*"
             Exclude="*.csproj;bin\**\*;obj\**\*;.ai\**\*;.template.config\**\*;$(OverlayContentExclude)" />
  </ItemGroup>

  <Target Name="Build">
    <Copy SourceFiles="@(Content)"
          DestinationFiles="@(Content->'$(OutputPath)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Clean touches only the staging folder — never a deploy root. -->
  <Target Name="Clean">
    <RemoveDir Directories="$(OutputPath)" Condition="Exists('$(OutputPath)')" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

  <!-- Answers NuGet's solution-restore probe (see the twin in Modlet.targets for the full story). -->
  <Target Name="_IsProjectRestoreSupported" Returns="@(_ValidProjectsForRestore)">
    <ItemGroup>
      <_ValidProjectsForRestore Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
  </Target>

  <!-- `dotnet test` on the solution forwards VSTest to every project. SDK projects inherit the target from
       Microsoft.TestPlatform.ImportAfter.targets (auto-imported by Microsoft.Common.targets) and no-op it for
       anything without IsTestProject=true; a bare <Project> never sees that import, so without this the whole
       command fails with MSB4057 (issue #51). Same shape as the restore probe above, and as the no-op Deploy in
       Tests.csproj: a project that cannot participate in a solution-wide target says so with an empty target
       rather than an error. -->
  <Target Name="VSTest" />

  <!-- Declaration sanity (#23) — the same target Deploy.targets carries for mods and modlets; duplicated here
       because overlays are self-contained by design (see the header). Keep the two in sync. -->
  <Target Name="_ValidateGameTreeDeclaration" BeforeTargets="Build;Deploy">
    <Error Condition="'$(SdtdUnit)' != 'game' AND '$(SdtdUnit)' != 'dedicated-server'"
           Text="$(MSBuildProjectName) has SdtdUnit '$(SdtdUnit)' — valid units: game, dedicated-server (build\GameVersions.props)." />
    <Error Condition="'$(SdtdTreeSource)' != 'packages' AND '$(SdtdTreeSource)' != 'vendor'"
           Text="$(MSBuildProjectName) has SdtdTreeSource '$(SdtdTreeSource)' — valid sources: packages (default, canonical), vendor (explicit, temporary)." />
    <Error Condition="'$(SdtdDevVersion)' != '$(_SdtdDevVersionAtResolve)'"
           Text="$(MSBuildProjectName) set SdtdDevVersion '$(SdtdDevVersion)' AFTER the game tree resolved with '$(_SdtdDevVersionAtResolve)': the declaration sits BELOW the entry-point props import, where the property reads back changed while every derived path silently keeps the old value (the OutDir-latch shape). Move it ABOVE the import — declarations above, deviations between." />
    <Error Condition="'$(SdtdDevVersion)' != '' AND $(_SdtdDevPackageVersion.Contains(';'))"
           Text="$(MSBuildProjectName) declares SdtdDevVersion '$(SdtdDevVersion)', which has no row in build\GameVersions.props' SdtdGameVersionMap. Labels are branch heads in semicolon-separated 'label=packageVersion' pairs — add the row, or fix the label." />
    <Message Importance="high" Condition="'$(SdtdTreeSource)' == 'vendor'"
             Text="  $(MSBuildProjectName): game tree from vendor\ (SdtdTreeSource=vendor is a TEMPORARY escape — packages is canonical)" />
  </Target>

  <!-- #37 destination-version check — Deploy.targets' _VerifyInstallVersion, adapted for overlays: the
       destination is $(DeployRoot), so the install root is two levels up (Hades: Mods\Hades -> the install).
       The saves overlay's root probes into AppData, finds no game assembly, and skips — a saves tree has no
       version. Keep in sync with Deploy.targets. -->
  <Target Name="_VerifyInstallVersion" BeforeTargets="Deploy"
          Condition="'$(IsDeployable)' == 'true' AND '$(SdtdSkipInstallVersionCheck)' != 'true'">
    <PropertyGroup>
      <_DeployInstallRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildStartupDirectory)', '$(DeployRoot)', '..', '..'))</_DeployInstallRoot>
      <_DeployDataDir Condition="Exists('$(_DeployInstallRoot)7DaysToDieServer_Data\Managed\Assembly-CSharp.dll')">7DaysToDieServer_Data</_DeployDataDir>
      <_DeployDataDir Condition="'$(_DeployDataDir)' == '' AND Exists('$(_DeployInstallRoot)7DaysToDie_Data\Managed\Assembly-CSharp.dll')">7DaysToDie_Data</_DeployDataDir>
      <_DeployInstallAsm Condition="'$(_DeployDataDir)' != ''">$(_DeployInstallRoot)$(_DeployDataDir)\Managed\Assembly-CSharp.dll</_DeployInstallAsm>
      <_DeployTargetUnit Condition="'$(_DeployDataDir)' == '7DaysToDieServer_Data'">dedicated-server</_DeployTargetUnit>
      <_DeployTargetUnit Condition="'$(_DeployDataDir)' == '7DaysToDie_Data'">game</_DeployTargetUnit>
      <_DeployTargetPackageId Condition="'$(_DeployTargetUnit)' == 'dedicated-server'">7dtd.assemblies.dedicatedserver</_DeployTargetPackageId>
      <_DeployTargetPackageId Condition="'$(_DeployTargetUnit)' == 'game'">7dtd.assemblies.game</_DeployTargetPackageId>
    </PropertyGroup>
    <ItemGroup Condition="'$(_DeployInstallAsm)' != ''">
      <_DeclaredVersion Include="$(SdtdTestVersions)" />
      <_DeclaredVersion>
        <PackageVersion>$([System.Text.RegularExpressions.Regex]::Replace(';$(SdtdGameVersionMap);', '^.*;%(Identity)=([^;]+);.*$', '$1'))</PackageVersion>
      </_DeclaredVersion>
      <_CandidatePath Include="@(_DeclaredVersion->'$(SdtdPackagesDir)\$(_DeployTargetPackageId)\%(PackageVersion)\$(_DeployDataDir)\Managed\Assembly-CSharp.dll')"
                      Condition="'$(SdtdTreeSource)' == 'packages' AND '@(_DeclaredVersion)' != ''" />
      <_CandidatePath Include="@(_DeclaredVersion->'$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\vendor'))\$(_DeployTargetUnit)\%(Identity)\$(_DeployDataDir)\Managed\Assembly-CSharp.dll')"
                      Condition="'$(SdtdTreeSource)' == 'vendor' AND '@(_DeclaredVersion)' != ''" />
      <_CandidateAsm Include="@(_CandidatePath)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <GetFileHash Files="$(_DeployInstallAsm)" Condition="'$(_DeployInstallAsm)' != ''">
      <Output TaskParameter="Hash" PropertyName="_DeployInstallAsmHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CandidateAsm)" Condition="'@(_CandidateAsm)' != ''">
      <Output TaskParameter="Items" ItemName="_CandidateAsmHashed" />
    </GetFileHash>
    <ItemGroup>
      <_MatchingVersion Include="@(_CandidateAsmHashed)" Condition="'%(_CandidateAsmHashed.FileHash)' == '$(_DeployInstallAsmHash)'" />
    </ItemGroup>
    <Error Condition="'$(_DeployInstallAsm)' != '' AND '@(_CandidateAsm)' == ''"
           Text="$(MSBuildProjectName): the deploy destination is a live $(_DeployTargetUnit) install ($(_DeployInstallRoot)), but none of its declared versions [$(SdtdTestVersions)] have a $(SdtdTreeSource) tree on this machine to verify it against. Restore the declared versions:  dotnet restore build/GameAssemblies.csproj --packages packages --configfile build/GameAssemblies.nuget.config  — or force with -p:SdtdSkipInstallVersionCheck=true (#37)." />
    <Error Condition="'$(_DeployInstallAsm)' != '' AND '@(_CandidateAsm)' != '' AND '@(_MatchingVersion)' == ''"
           Text="$(MSBuildProjectName) declares support for [$(SdtdTestVersions)], but the $(_DeployTargetUnit) install at $(_DeployInstallRoot) matches none of them — its Assembly-CSharp.dll differs from every declared version's tree. Deploying onto a game version the mod does not support is #37's failure mode. Verify the mod on this version and update SdtdTestVersions (or the repo default), or force with -p:SdtdSkipInstallVersionCheck=true." />
  </Target>

  <Target Name="Deploy" DependsOnTargets="Build" Condition="'$(IsDeployable)' == 'true'">
    <Error Condition="'$(ModsDir)' == ''"
           Text="build\Overlay.props was not imported by $(MSBuildProjectFile). Add &lt;Import Project=&quot;..\build\Overlay.props&quot; /&gt; as the first element of the project, BEFORE the properties that reference shared paths." />
    <Error Condition="'$(DeployRoot)' == ''"
           Text="Overlay project $(MSBuildProjectName) must set &lt;DeployRoot&gt; (e.g. $(ModsDir)\&lt;name&gt; or $(SdtdSavesDir)) between the Overlay.props and Overlay.targets imports." />
    <Error Condition="$(DeployRoot.StartsWith('\')) OR $(DeployRoot.StartsWith('/'))"
           Text="Overlay project $(MSBuildProjectName) has DeployRoot '$(DeployRoot)' — a rooted-but-driveless path, which means a property reference in it evaluated empty. Is the Overlay.props import missing or below the DeployRoot definition?" />
    <PropertyGroup>
      <_StagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutputPath)'))</_StagingDir>
      <!-- Anchored at the invocation directory, like build\Deploy.targets' _DeployDir (see its header for why
           a target-time relative path would mean the PROJECT's directory). Overlays build DeployRoot out of
           $(ModsDir) or $(SdtdSavesDir), so a relative -p: override for either arrives here. The driveless
           guard above runs first and is unaffected: an empty property reference still errors rather than
           being quietly anchored. -->
      <_DeployDir>$([MSBuild]::NormalizeDirectory('$(MSBuildStartupDirectory)', '$(DeployRoot)'))</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Partition the declarations: directories mirror recursively, files mirror individually. -->
      <_MirrorDir Include="@(MirrorOnDeploy)" Condition="$([System.IO.Directory]::Exists('$(_StagingDir)%(Identity)'))" />
      <_MirrorFileId Include="@(MirrorOnDeploy)" Exclude="@(_MirrorDir)" />

      <!-- Every batched include below is guarded against its source vector being EMPTY: MSBuild then expands
           %(...) to an empty string instead of zero iterations, silently turning the glob into the whole
           staging/deploy root — which made the entire deploy root mirror-scoped and DELETED unmanaged files
           (caught by verification, 2026-07-30). The guards are load-bearing; do not "simplify" them away. -->
      <_MirrorStaged Include="$(_StagingDir)%(_MirrorDir.Identity)\**\*"
                     Condition="'@(_MirrorDir)' != ''" />
      <_MirrorStaged Include="$(_StagingDir)%(_MirrorFileId.Identity)"
                     Condition="'@(_MirrorFileId)' != '' AND Exists('$(_StagingDir)%(_MirrorFileId.Identity)')" />
      <_MirrorStaged>
        <DestPath>$(_DeployDir)$([MSBuild]::MakeRelative('$(_StagingDir)', '%(FullPath)'))</DestPath>
      </_MirrorStaged>

      <_MirrorDeployed Include="$(_DeployDir)%(_MirrorDir.Identity)\**\*"
                       Condition="'@(_MirrorDir)' != ''" />
      <_MirrorDeployed Include="$(_DeployDir)%(_MirrorFileId.Identity)"
                       Condition="'@(_MirrorFileId)' != '' AND Exists('$(_DeployDir)%(_MirrorFileId.Identity)')" />
      <!-- Stale = deployed within a mirror scope but no longer staged. Deleted below; nothing outside the
           declared scopes is ever deleted. -->
      <_MirrorStale Include="@(_MirrorDeployed)" Exclude="@(_MirrorStaged->'%(DestPath)')" />

      <!-- Everything staged but not mirror-scoped deploys protectively: absent-or-newer only. -->
      <_ProtectedStaged Include="$(_StagingDir)**\*" Exclude="@(_MirrorStaged)" />
      <_ProtectedStaged>
        <DestPath>$(_DeployDir)$([MSBuild]::MakeRelative('$(_StagingDir)', '%(FullPath)'))</DestPath>
      </_ProtectedStaged>
      <_ProtectedStaged>
        <IsNewerThanDest Condition="!Exists('%(DestPath)') OR $([System.DateTime]::Parse('%(ModifiedTime)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('%(DestPath)').Ticks)">true</IsNewerThanDest>
      </_ProtectedStaged>
    </ItemGroup>

    <Copy SourceFiles="@(_MirrorStaged)" DestinationFiles="@(_MirrorStaged->'%(DestPath)')"
          SkipUnchangedFiles="true" />
    <Delete Files="@(_MirrorStale)" />
    <Copy SourceFiles="@(_ProtectedStaged)" DestinationFiles="@(_ProtectedStaged->'%(DestPath)')"
          Condition="'%(_ProtectedStaged.IsNewerThanDest)' == 'true'" />

    <Message Importance="high" Text="  $(MSBuildProjectName) overlaid -> $(_DeployDir)" />
    <Message Importance="high" Text="    removed stale (mirrored scope): @(_MirrorStale->'%(Filename)%(Extension)', ', ')"
             Condition="'@(_MirrorStale)' != ''" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)XmlLint.targets" />

</Project>
