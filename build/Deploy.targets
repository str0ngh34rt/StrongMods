<Project>

  <!--
    The explicit install step, shared by code mods (Mod.targets) and modlets (Modlet.targets). Not imported by
    projects directly — the two entry points pull it in, like GamePaths.props.

      dotnet build <proj> -t:Deploy         one project
      dotnet build StrongMods.sln -t:Deploy everything (MSBuild forwards the target to every project)

    Deploy MIRRORS the staged bin\ output into $(ModsDir)\$(ModDeployName)\: source is authoritative for content
    AND existence, so a file removed from source stops existing (and doing its thing) in the game at the next
    deploy. The mirror is strictly scoped to the mod's own deploy folder.

    Mirroring assumes this repo manages the whole deploy folder. A project that deploys into a directory with
    content the repo does not manage is an Overlay, not a Mod — use build\Overlay.targets instead. Hades is the
    example: its Worlds\ holds ~400 MB of world binaries authored outside this repo.

    Since the game-tree/install split (#23), $(ModsDir) derives from $(SdtdInstallDir) — never from
    $(SdtdDir) — so a deploy during a vendor-mode build (-p:SdtdDir=...) goes to the normal install, not into
    the tree.

    A relative -p:ModsDir resolves against the directory the command was run from — the same rule
    build\GamePaths.props applies to a relative -p:SdtdDir (#46). _DeployDir below names
    $(MSBuildStartupDirectory) to make that so, and the anchor is load-bearing rather than decorative: it is
    computed while the Deploy target RUNS, and MSBuild points the working directory at each PROJECT while
    running that project's targets. Left implicit, -p:ModsDir=.scratch/deploy wrote a .scratch\deploy folder
    beside EVERY deploying project and nothing at the repo root, reporting success (#52). An absolute value —
    every real deploy, and CI — discards the anchor and passes through unchanged.
  -->

  <!--
    Load-order tiers: a project declares intent via $(ModLoadTier); the map below turns it into the literal folder
    prefix. The game loads mods alphabetically by folder name with a CULTURE-AWARE comparison — verified from a
    client log, 2026-07-30:

      _disabled < 0_TFP_Harmony < 000000-StrongMods < plain names < Z_* < Z-IM-PZ-Compat < ZZ_* < ZZZZZZZZZZ_*

    Two non-obvious facts this map depends on:
      - Culture-aware, not ordinal: ordinal ASCII would sort ZZ_ BEFORE Z_ ('Z' 0x5A < '_' 0x5F). The prefixes only
        work because of the comparer the game actually uses.
      - 000000- is not absolutely first: 0_TFP_Harmony (the game's own Harmony bootstrap) precedes it. Correct and
        intended — the game enforces its Harmony mod loads first.

    AfterDependencies is two Z's because dependency folder names are hard to anticipate. The concrete case:
    Project Z deploys in two styles — the GA build is one mod whose folder starts with ProjectZ (sorts among plain
    names), the Experimental build is 10+ separate mods all starting with Z_. Following it in EITHER style needs
    at least ZZ.

    Last and LocalConfig share a prefix deliberately: the property encodes intent, the map collapses intents into
    sort bands, and order within a band is alphabetical by project name. $(ModLoadPrefix) remains the low-level
    escape hatch for anything a tier cannot express; setting both is an error (validated below).
  -->
  <PropertyGroup>
    <_ModLoadPrefixExplicit>$(ModLoadPrefix)</_ModLoadPrefixExplicit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModLoadTier)' != '' and '$(_ModLoadPrefixExplicit)' == ''">
    <ModLoadPrefix Condition="'$(ModLoadTier)' == 'First'">000000-</ModLoadPrefix>
    <ModLoadPrefix Condition="'$(ModLoadTier)' == 'AfterDependencies'">ZZ_</ModLoadPrefix>
    <ModLoadPrefix Condition="'$(ModLoadTier)' == 'Last'">ZZZZZZZZZZ_</ModLoadPrefix>
    <ModLoadPrefix Condition="'$(ModLoadTier)' == 'LocalConfig'">ZZZZZZZZZZ_</ModLoadPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <ModDeployName Condition="'$(ModDeployName)' == ''">$(ModLoadPrefix)$(MSBuildProjectName)</ModDeployName>
    <!-- Per-project capability gate, spelled after the SDK's own IsPackable/IsPublishable:
         <IsDeployable>false</IsDeployable> marks a project that must never install into the game. Both dotnet new
         templates set it (scaffolding, not shippable) and so does Tests (tooling, not a mod). -->
    <IsDeployable Condition="'$(IsDeployable)' == ''">true</IsDeployable>
  </PropertyGroup>

  <Target Name="_ValidateModLoadTier" BeforeTargets="Build;Deploy">
    <Error Condition="'$(ModLoadTier)' != '' and '$(_ModLoadPrefixExplicit)' != ''"
           Text="$(MSBuildProjectName) sets both ModLoadTier ('$(ModLoadTier)') and ModLoadPrefix ('$(_ModLoadPrefixExplicit)') — pick one. ModLoadTier is the preferred form; ModLoadPrefix is the escape hatch for what a tier cannot express." />
    <Error Condition="'$(ModLoadTier)' != '' and '$(ModLoadPrefix)' == ''"
           Text="$(MSBuildProjectName) sets unknown ModLoadTier '$(ModLoadTier)'. Valid tiers: First, AfterDependencies, Last, LocalConfig — see the map in build\Deploy.targets." />
  </Target>

  <!-- Declaration sanity for mods and modlets (#23; Overlay.targets carries its own copy — the entry points
       never combine). Target-time, so -getProperty evaluation and IDE loads always survive; each error
       teaches its fix. -->
  <Target Name="_ValidateGameTreeDeclaration" BeforeTargets="Build;Deploy">
    <Error Condition="'$(SdtdUnit)' != 'game' AND '$(SdtdUnit)' != 'dedicated-server'"
           Text="$(MSBuildProjectName) has SdtdUnit '$(SdtdUnit)' — valid units: game, dedicated-server (build\GameVersions.props)." />
    <Error Condition="'$(SdtdTreeSource)' != 'packages' AND '$(SdtdTreeSource)' != 'vendor'"
           Text="$(MSBuildProjectName) has SdtdTreeSource '$(SdtdTreeSource)' — valid sources: packages (default, canonical), vendor (explicit, temporary)." />
    <Error Condition="'$(SdtdDevVersion)' != '$(_SdtdDevVersionAtResolve)'"
           Text="$(MSBuildProjectName) set SdtdDevVersion '$(SdtdDevVersion)' AFTER the game tree resolved with '$(_SdtdDevVersionAtResolve)': the declaration sits BELOW the entry-point props import, where the property reads back changed while every derived path silently keeps the old value (the OutDir-latch shape). Move it ABOVE the import — declarations above, deviations between." />
    <Error Condition="'$(SdtdDevVersion)' != '' AND $(_SdtdDevPackageVersion.Contains(';'))"
           Text="$(MSBuildProjectName) declares SdtdDevVersion '$(SdtdDevVersion)', which has no row in build\GameVersions.props' SdtdGameVersionMap. Labels are branch heads in semicolon-separated 'label=packageVersion' pairs — add the row, or fix the label." />
    <Message Importance="high" Condition="'$(SdtdTreeSource)' == 'vendor'"
             Text="  $(MSBuildProjectName): game tree from vendor\ (SdtdTreeSource=vendor is a TEMPORARY escape — packages is canonical)" />
  </Target>

  <!-- #37: a live install must not receive a mod that does not declare support for its version. The subject
       is the DESTINATION install — client or dedicated server, whichever layout sits above $(ModsDir) — and
       its identity is the hash of its Assembly-CSharp.dll, compared against the same file in each declared
       (SdtdTestVersions) tree under the selected source. The unit follows the DESTINATION, not $(SdtdUnit): a
       modlet redirected to the server's Mods is checked against server trees. A destination with no game
       assembly above it — a .scratch redirect, the saves tree — is not an install and is not checked.
       Escape hatch: -p:SdtdSkipInstallVersionCheck=true. Overlay.targets carries an adapted copy (the entry
       points never combine); keep the two in sync. -->
  <Target Name="_VerifyInstallVersion" BeforeTargets="Deploy"
          Condition="'$(IsDeployable)' == 'true' AND '$(SdtdSkipInstallVersionCheck)' != 'true'">
    <PropertyGroup>
      <_DeployInstallRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildStartupDirectory)', '$(ModsDir)', '..'))</_DeployInstallRoot>
      <_DeployDataDir Condition="Exists('$(_DeployInstallRoot)7DaysToDieServer_Data\Managed\Assembly-CSharp.dll')">7DaysToDieServer_Data</_DeployDataDir>
      <_DeployDataDir Condition="'$(_DeployDataDir)' == '' AND Exists('$(_DeployInstallRoot)7DaysToDie_Data\Managed\Assembly-CSharp.dll')">7DaysToDie_Data</_DeployDataDir>
      <_DeployInstallAsm Condition="'$(_DeployDataDir)' != ''">$(_DeployInstallRoot)$(_DeployDataDir)\Managed\Assembly-CSharp.dll</_DeployInstallAsm>
      <_DeployTargetUnit Condition="'$(_DeployDataDir)' == '7DaysToDieServer_Data'">dedicated-server</_DeployTargetUnit>
      <_DeployTargetUnit Condition="'$(_DeployDataDir)' == '7DaysToDie_Data'">game</_DeployTargetUnit>
      <_DeployTargetPackageId Condition="'$(_DeployTargetUnit)' == 'dedicated-server'">7dtd.assemblies.dedicatedserver</_DeployTargetPackageId>
      <_DeployTargetPackageId Condition="'$(_DeployTargetUnit)' == 'game'">7dtd.assemblies.game</_DeployTargetPackageId>
    </PropertyGroup>
    <ItemGroup Condition="'$(_DeployInstallAsm)' != ''">
      <_DeclaredVersion Include="$(SdtdTestVersions)" />
      <!-- Label -> package version via the registry map (the GamePaths.props lookup, batched); a label with
           no row leaves the sentinel behind, whose path simply never exists. Empty-vector guards per the
           Overlay.targets lesson: an empty @() batch expands to ONE empty string, not zero iterations. -->
      <_DeclaredVersion>
        <PackageVersion>$([System.Text.RegularExpressions.Regex]::Replace(';$(SdtdGameVersionMap);', '^.*;%(Identity)=([^;]+);.*$', '$1'))</PackageVersion>
      </_DeclaredVersion>
      <_CandidatePath Include="@(_DeclaredVersion->'$(SdtdPackagesDir)\$(_DeployTargetPackageId)\%(PackageVersion)\$(_DeployDataDir)\Managed\Assembly-CSharp.dll')"
                      Condition="'$(SdtdTreeSource)' == 'packages' AND '@(_DeclaredVersion)' != ''" />
      <_CandidatePath Include="@(_DeclaredVersion->'$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\vendor'))\$(_DeployTargetUnit)\%(Identity)\$(_DeployDataDir)\Managed\Assembly-CSharp.dll')"
                      Condition="'$(SdtdTreeSource)' == 'vendor' AND '@(_DeclaredVersion)' != ''" />
      <_CandidateAsm Include="@(_CandidatePath)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <GetFileHash Files="$(_DeployInstallAsm)" Condition="'$(_DeployInstallAsm)' != ''">
      <Output TaskParameter="Hash" PropertyName="_DeployInstallAsmHash" />
    </GetFileHash>
    <GetFileHash Files="@(_CandidateAsm)" Condition="'@(_CandidateAsm)' != ''">
      <Output TaskParameter="Items" ItemName="_CandidateAsmHashed" />
    </GetFileHash>
    <ItemGroup>
      <_MatchingVersion Include="@(_CandidateAsmHashed)" Condition="'%(_CandidateAsmHashed.FileHash)' == '$(_DeployInstallAsmHash)'" />
    </ItemGroup>
    <Error Condition="'$(_DeployInstallAsm)' != '' AND '@(_CandidateAsm)' == ''"
           Text="$(MSBuildProjectName): the deploy destination is a live $(_DeployTargetUnit) install ($(_DeployInstallRoot)), but none of its declared versions [$(SdtdTestVersions)] have a $(SdtdTreeSource) tree on this machine to verify it against. Restore the declared versions:  dotnet restore build/GameAssemblies.csproj --packages packages --configfile build/GameAssemblies.nuget.config  — or force with -p:SdtdSkipInstallVersionCheck=true (#37)." />
    <Error Condition="'$(_DeployInstallAsm)' != '' AND '@(_CandidateAsm)' != '' AND '@(_MatchingVersion)' == ''"
           Text="$(MSBuildProjectName) declares support for [$(SdtdTestVersions)], but the $(_DeployTargetUnit) install at $(_DeployInstallRoot) matches none of them — its Assembly-CSharp.dll differs from every declared version's tree. Deploying onto a game version the mod does not support is #37's failure mode. Verify the mod on this version and update SdtdTestVersions (or the repo default), or force with -p:SdtdSkipInstallVersionCheck=true." />
  </Target>

  <Target Name="Deploy" DependsOnTargets="Build" Condition="'$(IsDeployable)' == 'true'">
    <PropertyGroup>
      <_StagingDir Condition="'$(ModStagingDir)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ModStagingDir)'))</_StagingDir>
      <_StagingDir Condition="'$(_StagingDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_StagingDir>
      <!-- $(MSBuildStartupDirectory) first: see the header. Absolute $(ModsDir) discards it. -->
      <_DeployDir>$([MSBuild]::NormalizeDirectory('$(MSBuildStartupDirectory)', '$(ModsDir)', '$(ModDeployName)'))</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_StagedFile Include="$(_StagingDir)**\*" />
      <!-- Stale = deployed but no longer staged. Deleted below: that is the mirror. -->
      <_StaleDeployedFile Include="$(_DeployDir)**\*"
                          Exclude="@(_StagedFile->'$(_DeployDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_StagedFile)"
          DestinationFiles="@(_StagedFile->'$(_DeployDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Delete Files="@(_StaleDeployedFile)" />
    <Message Importance="high" Text="  $(MSBuildProjectName) deployed (mirror) -> $(_DeployDir)" />
    <Message Importance="high" Text="    removed stale: @(_StaleDeployedFile->'%(Filename)%(Extension)', ', ')"
             Condition="'@(_StaleDeployedFile)' != ''" />
  </Target>

</Project>
