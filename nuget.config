<?xml version="1.0" encoding="utf-8"?>
<!--
  Makes NuGet restore behave identically on every machine, rather than depending on whatever feeds a developer
  happens to have configured globally. <clear /> drops inherited sources so a machine pointed only at a private
  feed still restores; the one package this repo needs (Cronos, used by BloodRain) comes from nuget.org.

  Restore with any standard toolchain: `dotnet restore`, `msbuild -restore`, or an IDE on solution load.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
